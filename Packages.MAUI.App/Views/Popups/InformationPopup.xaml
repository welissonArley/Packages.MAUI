<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Packages.MAUI.App.Views.Popups.InformationPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModel="clr-namespace:Packages.MAUI.App.ViewModels.Popups.Information"
    Padding="0"
    x:DataType="viewModel:InformationVieweModel">

    <VerticalStackLayout
        Padding="30,40,30,30"
        BackgroundColor="White"
        Spacing="10"
        VerticalOptions="Center">

        <Label
            FontAttributes="Bold"
            FontSize="22"
            Text="{Binding Title}"
            TextColor="Black" />

        <Label
            Margin="0,0,0,30"
            FontSize="18"
            Text="{Binding Message}"
            TextColor="Black" />

        <Button
            BackgroundColor="#027AFF"
            Command="{Binding CloseCommand}"
            CornerRadius="10"
            FontAttributes="Bold"
            HeightRequest="50"
            Text="Nice :)"
            TextColor="White" />
    </VerticalStackLayout>
</toolkit:Popup>